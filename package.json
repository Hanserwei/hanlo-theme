{
  "name": "theme-hanlo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build-only && pnpm run package",
    "build-only": "pnpm run validate && tsc --noEmit && vp build && pnpm run verify-build",
    "check": "pnpm run validate && tsc --noEmit && pnpm run check:css && vp check vite.config.ts vite-env.d.ts scripts/*.mjs scripts/release/*.mjs src/js tests vitest.config.ts stylelint.config.mjs",
    "check:css": "stylelint \"src/css/**/*.css\" && node scripts/validate-css-architecture.mjs",
    "dev": "vp build --watch",
    "icons:check": "node scripts/sync-dashboard-icons.mjs --check",
    "icons:sync": "node scripts/sync-dashboard-icons.mjs",
    "menu-icons:check": "node scripts/generate-menu-icons.mjs --check",
    "menu-icons:sync": "node scripts/generate-menu-icons.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "package": "node scripts/package-theme.mjs",
    "test": "pnpm run test:unit && pnpm run test:settings",
    "test:unit": "vitest run",
    "test:markmap-runtime": "node scripts/verify-markmap-runtime.mjs",
    "test:settings": "node --test tests/settings-*.test.mjs",
    "settings:check": "node scripts/validate-settings.mjs",
    "validate": "node scripts/validate-theme.mjs && node scripts/validate-settings.mjs && node scripts/sync-dashboard-icons.mjs --check && node scripts/generate-menu-icons.mjs --check && node scripts/generate-third-party-notices.mjs --check",
    "verify-build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "ba-click-fx": "1.3.15",
    "dplayer": "1.27.1",
    "fast-average-color": "9.6.0",
    "gsap": "3.15.1",
    "hls.js": "1.7.4",
    "matter-js": "0.20.0",
    "opencc-js": "1.4.2",
    "parse5": "8.1.1",
    "qrcode": "1.5.4",
    "shiki": "4.6.0",
    "swiper": "14.4.0",
    "tocbot": "4.36.8",
    "typed.js": "3.0.0"
  },
  "devDependencies": {
    "@antdv-next/icons": "1.1.2",
    "@formkit/core": "2.5.0",
    "@halo-dev/theme-package-cli": "1.1.1",
    "@halo-dev/vite-plugin-halo-theme": "1.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/dplayer": "1.25.6",
    "@types/matter-js": "0.20.2",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.187.0",
    "@vue/server-renderer": "3.5.45",
    "linkedom": "0.18.15",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
