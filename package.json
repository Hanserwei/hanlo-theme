{
  "name": "theme-hanlo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build-only && pnpm run package",
    "build-only": "pnpm run validate && tsc --noEmit && vp build && pnpm run verify-build",
    "check": "pnpm run validate && tsc --noEmit && pnpm run check:css && vp check vite.config.ts vite-env.d.ts scripts/*.mjs src/js tests playwright.config.ts vitest.config.ts stylelint.config.mjs",
    "check:css": "stylelint \"src/css/**/*.css\" && node scripts/validate-css-architecture.mjs",
    "dev": "vp build --watch",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "package": "node scripts/package-theme.mjs",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "validate": "node scripts/validate-theme.mjs && node scripts/generate-third-party-notices.mjs --check",
    "verify-build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "1.1.1",
    "@halo-dev/vite-plugin-halo-theme": "1.0.3",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/dplayer": "1.25.6",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "parse5": "8.0.1",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "dplayer": "1.27.1",
    "fast-average-color": "9.5.2",
    "hls.js": "1.7.1",
    "qrcode": "1.5.4",
    "shiki": "4.4.3",
    "swiper": "14.2.0",
    "tocbot": "4.36.8",
    "typed.js": "2.0.12"
  }
}
